{
  "name": "supplier-quote-comparison",
  "version": "1.0.0",
  "description": "A CAP learning project for comparing supplier quotes.",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "start:local": "cds-serve --port 4010",
    "watch": "cds watch",
    "test": "node --test test/*.test.js",
    "lint": "eslint app srv test --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "@sap/cds-dk": "^10"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "mocked"
      }
    }
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "eslint": "^10.9.1"
  }
}
